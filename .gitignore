# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code
.claude
scripts/
!scripts/sync-shorts.mjs


# playwright mcp
.playwright-mcp/

# Prose docs and fixtures. Ignored on purpose: `docs/fixtures/` holds a private
# client recording, and publishing a business conversation into a public
# portfolio repo to gain a test fixture is not a defensible trade. The tests
# that use those fixtures skip when they are absent.
/docs
/documentation

# Debugging leftovers from the transcription tool. These are transcripts and
# screenshots OF REAL CALLS — `q4-excerpt.txt` and `editor-1200.png` both reached
# a public repo once already. Anything captured out of the subtitler stays local.
/*-excerpt.txt
/*-transcript.txt
/editor-*.png
/subtitler-*.png
/crash-notice*.png
/model-manager-*.png
